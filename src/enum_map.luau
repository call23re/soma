local function normalize(input: InputCode): string
	if typeof(input) == "EnumItem" then
		input = input.Name
	end
	input = input :: string

	local result = input:gsub("(%u+)(%u%l)", "%1_%2")
	result = result:gsub("(%l)(%u)", "%1_%2")
	result = result:gsub("[%-%s]+", "_")
	result = result:gsub("^_+", ""):gsub("_+$", "")
	result = result:gsub("_+", "_")
	return result:upper()
end

local function as_key_code(kind: InputKind, input: InputCode)
	input = normalize(input)
	if kind == "Key" then
		return MAP["KEY"][input] or Enum.KeyCode.Unknown
	elseif kind == "Gamepad" then
		return MAP["GAMEPAD"][input] or Enum.KeyCode.Unknown
	elseif kind == "Mouse" then
		return MAP["MOUSE"][input] or Enum.KeyCode.Unknown
	elseif kind == "Touch" then
		return MAP["TOUCH"][input] or Enum.KeyCode.Unknown
	end

	return Enum.KeyCode.Unknown
end

return {
	MAP = MAP,
	as_key_code = as_key_code,
}
